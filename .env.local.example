# ========================================================
# HANOON ACADEMY - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ========================================================
# Copy this file to .env.local and populate with your credentials.
#
# Obtain from your Supabase Dashboard:
# -> Project Settings -> API -> Project URL & anon/public API key
# ========================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Public Application URL for production redirects & links
NEXT_PUBLIC_APP_URL=http://localhost:3000
